{
  "manifest_version": 2,
  "name": "Civitai Grabber Bridge",
  "version": "0.18.0",
  "description": "Connects the Civitai Grabber program with your browser: adds Civitai pages to its list and reads pages for it with your login.",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "nativeMessaging",
    "http://127.0.0.1/*",
    "https://*.civitai.com/*",
    "https://*.civitai.red/*",
    "https://civitai.com/*",
    "https://civitai.red/*"
  ],
  "background": {
    "scripts": [
      "common.js",
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "Civitai Grabber Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "civitai-grabber-bridge@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  },
  "homepage_url": "https://github.com/Overbooster/civitai-grabber"
}