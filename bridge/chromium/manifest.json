{
  "manifest_version": 3,
  "name": "Civitai Grabber Bridge",
  "version": "0.17.0",
  "description": "Connects the Civitai Grabber program with your browser: adds Civitai pages to its list and reads pages for it with your login.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "tabs",
    "alarms",
    "scripting",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://*.civitai.com/*",
    "https://*.civitai.red/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Civitai Grabber Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon.png"
  }
}